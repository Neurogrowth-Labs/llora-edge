# Required in every deployed environment. Use a least-privilege PostgreSQL role.
DATABASE_URL=postgres://lora_app:change-me@127.0.0.1:5432/lora_edge
NODE_ENV=development
SESSION_COOKIE_NAME=lora_session
SESSION_TTL_DAYS=14
DATABASE_POOL_MAX=10
# Set to false only for a managed PostgreSQL provider that requires a custom CA strategy.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
GEMINI_API_KEY=
IFCOPENSHELL_BINARY=IfcConvert
